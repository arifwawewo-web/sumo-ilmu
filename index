const VARIANTS=[{n:'Original',l:'data:image/jpeg;base64,',r:'data:image/jpeg;base64,'},{n:'Blaze',l:'data:image/jpeg;base64,',r:'data:image/jpeg;base64,'},{n:'Volt',l:'data:image/jpeg;base64,',r:'data:image/jpeg;base64,'},{n:'Nova',l:'data:image/jpeg;base64,',r:'data:image/jpeg;base64,'},{n:'Gold',l:'data:image/jpeg;base64,',r:'data:image/jpeg;base64,'},{n:'Shadow',l:'data:image/jpeg;base64,',r:'data:image/jpeg;base64,'},{n:'Zenith',l:'data:image/jpeg;base64,',r:'data:image/jpeg;base64,'}];
