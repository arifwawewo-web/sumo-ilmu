function startPO(seeds){phase='po';SEEDL=seeds;KK=seeds.length;PO=buildTpl(KK);round()}
function res(src){return src.s?SEEDL[src.s-1]:src.w?src.w.win:src.l.lose}
function buildTpl(K){const n=Math.log2(K),T=[],mk=(br,r,i,a,b)=>{const t={br,r,i,a,b,done:0};T.push(t);return t};
 let ord=[1];for(let s=2;s<=K;s*=2){const nx=[];ord.forEach(x=>nx.push(x,s+1-x));ord=nx}
 const UB=[],LB=[];UB[1]=[];for(let i=0;i<K/2;i++)UB[1].push(mk('ub',1,i,{s:ord[2*i]},{s:ord[2*i+1]}));
 for(let r=2;r<=n;r++){UB[r]=[];for(let i=0;i<K/Math.pow(2,r);i++)UB[r].push(mk('ub',r,i,{w:UB[r-1][2*i]},{w:UB[r-1][2*i+1]}))}
 LB[1]=[];for(let i=0;i<K/4;i++)LB[1].push(mk('lb',1,i,{l:UB[1][2*i]},{l:UB[1][2*i+1]}));
 for(let j=2;j<=2*(n-1);j++){LB[j]=[];const pv=LB[j-1];
  if(j%2==0){const k=j/2;for(let i=0;i<pv.length;i++)LB[j].push(mk('lb',j,i,{l:UB[k+1][pv.length-1-i]},{w:pv[i]}))}
  else for(let i=0;i<pv.length/2;i++)LB[j].push(mk('lb',j,i,{w:pv[2*i]},{w:pv[2*i+1]}))}
 const lbL=LB[2*(n-1)][0];lbL.last=1;const gf=mk('gf',1,0,{w:UB[n][0]},{w:lbL});
 SEQ=[];SEQ.push(UB[1]);if(n>=2)SEQ.push(UB[2]);SEQ.push(LB[1]);
 for(let r=3;r<=n;r++){SEQ.push(UB[r]);const j=2*(r-2);SEQ.push(LB[j]);SEQ.push(LB[j+1])}
 for(let j=1;j<=2*(n-1);j++)if(!SEQ.includes(LB[j]))SEQ.push(LB[j]);SEQ.push([gf]);
 let id=1;SEQ.forEach(g=>g.forEach(t=>t.id=id++));
 const {BW,DX,X0,SP,BH}=BRC,ubTop=46;UB[1].forEach((m,i)=>m.y=ubTop+i*SP);
 for(let r=2;r<=n;r++)UB[r].forEach((m,i)=>m.y=(UB[r-1][2*i].y+UB[r-1][2*i+1].y)/2);
 const sepY=UB[1][UB[1].length-1].y+BH+18,lbTop=sepY+54;LB[1].forEach((m,i)=>m.y=lbTop+i*SP);
 for(let j=2;j<=2*(n-1);j++)LB[j].forEach((m,i)=>m.y=j%2==0?LB[j-1][i].y:(LB[j-1][2*i].y+LB[j-1][2*i+1].y)/2);
 for(let r=1;r<=n;r++)UB[r].forEach(m=>m.c=r-1);for(let j=1;j<=2*(n-1);j++)LB[j].forEach(m=>m.c=j-1);
 const gc=Math.max(n-1,2*(n-1)-1)+1;gf.c=gc;gf.y=(UB[n][0].y+lbL.y)/2;
 BRD={W:X0+gc*DX+BW+14,H:LB[1][LB[1].length-1].y+BH+22,sepY};return T}
function draw(){if(phase=='swiss'&&SR===1&&!revealed){revealPairs();return}renderBoard()}
function revealPairs(){show('shuffle');const box=$('shBoard');box.innerHTML='';const list=M.slice();let idx=0;
 function next(){if(idx>=list.length){if(BYE){const d=document.createElement('div');d.className='pcard';d.innerHTML=`<b>${BYE.n}</b><span class="wo">WO — lolos otomatis</span>`;box.appendChild(d);requestAnimationFrame(()=>d.classList.add('in'));snd(600,.2,'triangle')}setTimeout(()=>{revealed=true;renderBoard()},1400);return}
  const m=list[idx];const d=document.createElement('div');d.className='pcard';d.innerHTML=`<b>${m[0].n}</b><span>VS</span><b>${m[1].n}</b>`;box.appendChild(d);requestAnimationFrame(()=>d.classList.add('in'));snd(480+idx*18,.15);idx++;setTimeout(next,650)}
 next()}
function renderBoard(){show('board');$('board').classList.toggle('pob',phase=='po'||phase=='done');
 $('pairs').innerHTML=M.map((m,i)=>`<div class="pair ${i==mi?'now':''} ${i<mi?'done':''}">${m.t?`<small style="display:block;color:#fffa;font-size:.55em">${m.t.br=='gf'?'GRAND FINAL':'MATCH '+m.t.id}</small>`:''}${m[0].n} <span style="color:var(--gold)">VS</span> ${m[1].n}</div>`).join('')+(BYE?`<div class="pair" style="background:#9b5cf655">${BYE.n} — WO ✅ menang otomatis</div>`:'')+(BYT?`<div class="pair" style="background:#9b5cf655;font-size:.75em">${BYT} — lolos otomatis ronde ini</div>`:'');
 if(phase=='swiss')swissBoard();else if(phase=='wc')wcBoard();else poBoard();
 P.forEach(p=>p.mv=0);
 $('go').style.display=(M.length&&phase!='done')?'inline-block':'none';$('endbar').style.display=phase=='done'?'flex':'none'}
const chip=p=>`<span class="ch ${p.st} ${p.mv?'new':''}">${p.n}</span>`;
const rowH=m=>{const w=m.win,np=(p,sc,r)=>`<span class="np ${w===p?'wn':w?'ls':''}">${r?`<i>${sc}</i><u>${p.n}</u>`:`<u>${p.n}</u><i>${sc}</i>`}</span>`;return `<div class="mr ${M[mi]===m&&!m.done?'cur':''}">${np(m[0],m.done?m.sa:0,0)}<em>VS</em>${np(m[1],m.done?m.sb:0,1)}</div>`};
const lst=(a,c,t)=>`<div class="bx ${c}"><div class="bt">${t} • ${a.length}</div><div class="cw">${a.map(chip).join('')||'<small>Belum ada</small>'}</div></div>`;
function swissBoard(){const bx=(k,t)=>{const ms=H.filter(m=>m.br=='swiss'&&m.box==k);const wt=P.filter(p=>p.st=='swiss'&&(p.w+'-'+p.l)==k&&!M.some(mm=>!mm.done&&(mm[0]===p||mm[1]===p)));return `<div class="bx"><div class="bt">${t}${ms.length?' • '+ms.length+' duel':''}</div>${ms.map(rowH).join('')||(wt.length?'':'<div class="mr" style="opacity:.5">Belum ada</div>')}${wt.length?`<div class="cw"><small>⏳ Menunggu lawan:</small>${wt.map(chip).join('')}</div>`:''}</div>`};
 const cols=[],maxSum=(WN-1)+(LN-1);
 for(let s=0;s<=maxSum;s++){let boxes='';for(let w=Math.min(s,WN-1);w>=0;w--){const l=s-w;if(l<0||l>LN-1)continue;boxes+=bx(w+'-'+l,w+'-'+l)}if(boxes)cols.push(`<div>${boxes}<div class="plate">Swiss Stage ${s+1}</div></div>`)}
 const resCol=`<div>${lst(P.filter(p=>p.w>=WN),'win','✅ Lolos Playoff')}${lst(P.filter(p=>p.l>=LN),'wcg','⚡ Wildcard (kesempatan kedua)')}<div style="font-size:.8em;opacity:.85;margin:-4px 0 8px">Rebutan slot Playoff yang belum terisi. Kalau slot sudah penuh, Wildcard tidak main.</div><div class="plate">Hasil Swiss</div></div>`;
 $('bk').innerHTML=`<div class="bk" style="grid-template-columns:repeat(${cols.length+1},1fr)">${cols.join('')}${resCol}</div>`}
function wcBoard(){const a=H.filter(m=>m.br=='wc'),al=P.filter(p=>p.st=='wc');
 $('bk').innerHTML=`<div class="bk" style="grid-template-columns:1fr 1fr"><div class="bx wcg"><div class="bt">⚡ Wildcard • ${a.length} duel</div>${a.map(rowH).join('')||'<div class="mr" style="opacity:.5">Belum ada</div>'}</div>${lst(al,'wcg','Masih bertahan')}</div><div style="font-size:20px;margin:6px">Memperebutkan <b style="color:var(--gold)">${SLOTS}</b> slot terakhir Playoff</div>`}
function poBoard(){if(!PO.length){$('bk').innerHTML='';return}
 const {BW,DX,X0}=BRC,{W,H:HH,sepY}=BRD,cur=M[mi]&&M[mi].t,nm=t=>t.length>15?t.slice(0,14)+'…':t;
 const px=t=>X0+t.c*DX,slotY=(t,k)=>t.y+(k?35:11);let ln='',bx='';
 PO.forEach(t=>[t.a,t.b].forEach((src,k)=>{if(!src.w)return;const f=src.w,x1=px(f)+BW,y1=f.y+23,x2=px(t),y2=slotY(t,k),xm=x2-14,col=t.br=='lb'||(t.br=='gf'&&k)?'#4fb3d9':'#f5b93a';
  ln+=`<path d="M${x1} ${y1}H${xm}V${y2}H${x2}" fill="none" stroke="${col}" stroke-width="2" opacity="${f.done?1:.35}"/>`}));
 PO.forEach(t=>{const x=px(t),y=t.y,lb=t.br=='lb',gf=t.br=='gf',fill=lb?'#2a7fa8':gf?'#ffd25a':'#c9a24a',tx=lb?'#fff':'#2a1c00';
  const ph=src=>src.w?'PEMENANG MATCH '+src.w.id:src.l?'KALAH MATCH '+src.l.id:'';
  const row=(k,src,sc)=>{const p=res(src),yy=y+k*24,win=t.done&&t.win===p,los=t.done&&t.lose===p;
   return `<g opacity="${los?.45:1}"><rect x="${x}" y="${yy}" width="${BW}" height="22" rx="5" fill="${fill}"${win?' stroke="#fff" stroke-width="2.5"':''}/>`+(p?`<text x="${x+8}" y="${yy+16}" font-size="13" font-weight="800" fill="${tx}">${esc(nm(p.n))}</text>`:`<text x="${x+8}" y="${yy+15}" font-size="9.5" font-weight="700" fill="${tx}" opacity=".6">${ph(src)}</text>`)+(t.done?`<rect x="${x+BW-26}" y="${yy}" width="26" height="22" rx="5" fill="#0007"/><text x="${x+BW-13}" y="${yy+16}" text-anchor="middle" font-size="13" font-weight="900" fill="#fff">${sc}</text>`:'')+'</g>'};
  const rdy=M.some(m=>m.t===t)&&!t.done;
  bx+=`<text x="${x}" y="${y-5}" font-size="11" font-weight="800" fill="${lb?'#8fd3ee':'#f0d68a'}">${gf?'GRAND FINAL':'MATCH '+t.id}</text>`+(rdy?`<rect class="${t===cur?'hl':''}" x="${x-4}" y="${y-3}" width="${BW+8}" height="52" rx="8" fill="none" stroke="${t===cur?'#fff':'#ffffff88'}" stroke-width="${t===cur?3:1.5}" stroke-dasharray="${t===cur?'':'4 3'}"/>`:'')+row(0,t.a,t.sa)+row(1,t.b,t.sb)});
 $('bk').innerHTML=`<svg id="brk" viewBox="0 0 ${W} ${HH}" preserveAspectRatio="xMidYMin meet" font-family="Trebuchet MS,Segoe UI,Arial,sans-serif"><text x="${X0}" y="16" font-size="15" font-weight="900" letter-spacing="3" fill="#f5b93a">UPPER BRACKET</text><line x1="0" x2="${W}" y1="${sepY}" y2="${sepY}" stroke="#ffffff66" stroke-dasharray="7 6"/><text x="${X0}" y="${sepY+24}" font-size="15" font-weight="900" letter-spacing="3" fill="#4fb3d9">LOWER BRACKET</text>${ln}${bx}</svg>`}
function nextDuel(){const m=M[mi];startDuel(m[0],m[1])}
function startDuel(a,b){D={a,b,sa:0,sb:0,pos:0,n:0,act:false,wr:[0,0],lk:[0,0]};$('vl').textContent=a.n;$('vr').textContent=b.n;$('nl').textContent=a.n;$('nr').textContent=b.n;
 const rl=a.rc||VARIANTS[0],rr=b.rc||VARIANTS[0];
 $('iml').src=rl.l;$('imr').src=rr.r;
 $('nl').innerHTML=esc(a.n)+'<small style="display:block;font-weight:700;font-size:.55em;opacity:.85">SEMA-5 '+rl.n+'</small>';
 $('nr').innerHTML=esc(b.n)+'<small style="display:block;font-weight:700;font-size:.55em;opacity:.85">SEMA-5 '+rr.n+'</small>';
 $('sl').style.transform=$('sr').style.transform='';$('sl').classList.remove('fly');$('sr').classList.remove('fly');
 $('vs').classList.add('on');snd(180,.4,'sawtooth');setTimeout(()=>{$('vs').classList.remove('on');show('duel');nextQ()},1700)}
function showRoundBanner(n,cb){const el=$('roundcall'),t1=document.createElement('div');t1.className='rc-text rc-round';t1.textContent='RONDE '+n;el.appendChild(t1);
 requestAnimationFrame(()=>t1.classList.add('show'));snd(220,.16,'triangle');setTimeout(()=>snd(330,.16,'triangle'),110);
 setTimeout(()=>{t1.classList.remove('show');t1.classList.add('rc-out');
  setTimeout(()=>{t1.remove();const t2=document.createElement('div');t2.className='rc-text rc-fight';t2.textContent='MULAI!';el.appendChild(t2);
   requestAnimationFrame(()=>t2.classList.add('show'));snd(90,.22,'sawtooth');flash();
   setTimeout(()=>{t2.classList.remove('show');t2.classList.add('rc-out');setTimeout(()=>{t2.remove();cb()},220)},380)},240)},700)}
function nextQ(){D.n++;D.act=false;$('q').textContent='';$('bl').innerHTML='';$('br').innerHTML='';$('info').textContent='';
 const q=CURBANK[QO[qp++%QO.length]];D.wr=[0,0];D.lk=[0,0];
 showRoundBanner(D.n,()=>{buildQ(q)})}
function buildQ(q){
 $('q').textContent=q[0];$('info').textContent='Soal '+D.n+' dari 5 • duluan 3 poin';pips();
 ['bl','br'].forEach((id,s)=>{const o=sh(q.slice(1).map((t,i)=>({t,ok:i==0})));$(id).innerHTML='';o.forEach((x,i)=>{const b=document.createElement('button');b.className='opt';b.textContent=x.t;b.dataset.ok=x.ok?1:0;b.onpointerdown=e=>{e.preventDefault();press(s,b)};$(id).appendChild(b)})});D.act=true}
function press(s,b){if(!D||!D.act||D.lk[s])return;if(b.dataset.ok=='1'){D.act=false;push(s)}else{D.lk[s]=1;D.wr[s]=1;snd(120,.25,'sawtooth');const bs=[...b.parentNode.children];bs.forEach(x=>x.disabled=true);
  if(D.wr[0]&&D.wr[1]){D.act=false;$('info').textContent='Dua-duanya salah! Soal baru...';setTimeout(()=>{D.n--;nextQ()},1000)}
  else setTimeout(()=>{D.lk[s]=0;bs.forEach(x=>x.disabled=false)},1500)}}
function hpSet(id,rem){const el=$(id),pct=Math.max(0,rem)/3*100;el.style.width=pct+'%';el.classList.remove('mid','low');if(rem<=1)el.classList.add('low');else if(rem==2)el.classList.add('mid')}
function pips(){hpSet('hpl',3-D.sb);hpSet('hpr',3-D.sa)}
function push(s){s?D.sb++:D.sa++;D.pos=(D.sa-D.sb)/3;pips();const px=D.pos*90;$('sl').style.transform=$('sr').style.transform=`translateX(${px}px)`;
 $('info').textContent=(s?D.b.n:D.a.n)+' DORONG! 💥';snd(520,.15);setTimeout(()=>snd(760,.15),90);flash();const svgR=document.querySelector('#duel .arena').getBoundingClientRect();spark(svgR.left+svgR.width*(s?.32:.68),svgR.top+svgR.height*.72,s?'#ff7a2e':'#2fbf71');const g=$('duel');g.classList.remove('shake');void g.offsetWidth;g.classList.add('shake');
 setTimeout(()=>{if(D.sa>=3||D.sb>=3)endDuel();else nextQ()},1100)}
function endDuel(){D.act=false;const w=D.pos>0?D.a:D.b,l=D.pos>0?D.b:D.a,loserEl=$(D.pos>0?'sr':'sl');
 loserEl.style.setProperty('--fx',(D.pos>0?300:-300)+'px');loserEl.style.setProperty('--fr',(D.pos>0?540:-540)+'deg');loserEl.classList.add('fly');snd(90,.6,'sawtooth');flash();const svgR2=document.querySelector('#duel .arena').getBoundingClientRect();spark(svgR2.left+svgR2.width/2,svgR2.top+svgR2.height*.65,'#f5b93a',34);
 $('info').textContent='🏅 '+w.n+' MENANG!';setTimeout(()=>{const cm=M[mi];cm.sa=D.sa;cm.sb=D.sb;cm.win=w;cm.done=1;if(cm.t){const t=cm.t;t.win=w;t.lose=l;t.done=1;t.sa=D.sa;t.sb=D.sb;if(t.br!='ub')l.st='out';if(t.br=='gf'){champion(w,l,(PO.find(x=>x.last)||{}).lose);return}}else apply(w,l);mi++;if(mi>=M.length){round()}else draw()},2300)}
function apply(w,l){w.mv=l.mv=1;if(phase=='swiss'){w.w++;l.l++;if(w.w>=WN)w.st='q';if(l.l>=LN)l.st='wc'}else if(phase=='wc'){l.st='out'}else if(phase=='ub'){l.st='lb'}else if(phase=='lb'){l.st='out'}else{l.st='out'}}
function champion(p,r,t){phase='done';M=[];BYE=null;BYT='';const c=$('cine');$('cname').textContent=p.n;
 $('cpod').innerHTML=(r?`<div class="pod"><small>🥈 Juara 2</small>${esc(r.n)}</div>`:'')+`<div class="pod g"><small>🥇 Juara 1</small>${esc(p.n)}</div>`+(t?`<div class="pod"><small>🥉 Juara 3</small>${esc(t.n)}</div>`:'');
 c.classList.remove('rev');c.classList.add('on');let k=0,gap=430;const roll=()=>{if(k>=16)return;snd(60+k*7,.12,'sawtooth');k++;gap=Math.max(80,gap*.87);setTimeout(roll,gap)};setTimeout(roll,900);setTimeout(reveal,4400)}
function reveal(){const c=$('cine');flash();c.classList.add('rev','shk');setTimeout(()=>c.classList.remove('shk'),600);snd(65,.9,'sawtooth');[523,659,784,1047,1319].forEach((f,i)=>setTimeout(()=>snd(f,.5,'triangle'),i*140));
 for(let i=0;i<11;i++)setTimeout(()=>spark(60+Math.random()*(innerWidth-120),60+Math.random()*innerHeight*.6,['#f5b93a','#2fbf71','#ff7a2e','#9b5cf6','#ffffff'][i%5],36,2.6),300+i*380);
 for(let i=0;i<110;i++){const d=document.createElement('div');d.className='cf';d.style.left=Math.random()*100+'vw';d.style.background=['#f5b93a','#2fbf71','#ff7a2e','#9b5cf6'][i%4];d.style.animationDuration=2+Math.random()*3+'s';d.style.animationDelay=Math.random()*2.5+'s';document.body.appendChild(d);setTimeout(()=>d.remove(),8000)}}
function backCine(){$('cine').classList.add('on','rev')}
function hideCine(){$('cine').classList.remove('on','rev');$('ph').textContent='🏆 Bagan Akhir';$('rule').textContent='';renderBoard()}
window.addEventListener('DOMContentLoaded',()=>{try{loadSheet()}catch(e){}try{runIntro()}catch(e){}});
document.addEventListener('keydown',e=>{if(!D||!D.act||!$('duel').classList.contains('on'))return;const kl='qwer',kr='uiop',k=e.key.toLowerCase();let i=kl.indexOf(k),s=0;if(i<0){i=kr.indexOf(k);s=1}if(i<0)return;const b=$(s?'br':'bl').children[i];if(b)press(s,b)});
</script></body></html>
