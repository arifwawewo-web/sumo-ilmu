}
function leaveIntroF(){const el=document.getElementById('introf');if(!el)return;INTROTO.forEach(clearTimeout);snd(500,.3,'triangle');el.classList.add('leave');setTimeout(()=>el.remove(),700)}
function flash(){const f=$('flash');f.style.opacity='.32';setTimeout(()=>f.style.opacity='0',110)}
function spark(cx,cy,color,n,sc){n=n||16;sc=sc||1;for(let i=0;i<n;i++){const d=document.createElement('div');d.className='spark';d.style.left=cx+'px';d.style.top=cy+'px';d.style.background=color;d.style.color=color;d.style.opacity='1';d.style.transition='transform .55s ease-out,opacity .55s';document.body.appendChild(d);const ang=Math.random()*6.283,dist=(35+Math.random()*80)*sc;requestAnimationFrame(()=>{d.style.transform=`translate(${Math.cos(ang)*dist}px,${Math.sin(ang)*dist}px)`;d.style.opacity='0'});setTimeout(()=>d.remove(),600)}}
function show(id){document.querySelectorAll('.scr').forEach(s=>s.classList.remove('on'));$(id).classList.add('on');document.body.classList.toggle('wcb',phase=='wc')}
for(let i=4;i<=30;i++)$('cnt').add(new Option(i+' peserta'+(i%2?' (ganjil)':''),i));$('cnt').value=8;
function oddNote(){$('odd').textContent=$('cnt').value%2?'Jumlah ganjil: 1 peserta tiap ronde mendapat WO (menang otomatis).':''}
function parseCSV(t){const rows=[];let row=[],cur='',q=false;for(let i=0;i<t.length;i++){const c=t[i];if(q){if(c=='"'){if(t[i+1]=='"'){cur+='"';i++}else q=false}else cur+=c}else{if(c=='"')q=true;else if(c==','){row.push(cur);cur=''}else if(c=='\n'||c=='\r'){if(c=='\r'&&t[i+1]=='\n')i++;row.push(cur);cur='';rows.push(row);row=[]}else cur+=c}}if(cur.length||row.length){row.push(cur);rows.push(row)}return rows.filter(r=>r.length>1||(r[0]||'').trim())}
async function loadSheet(){const url=$('sheetUrl').value.trim();$('startBtn').disabled=true;SHEETROWS=[];$('filterWrap').style.display='none';$('bankCount').textContent='';
 if(!url){$('sheetStatus').textContent='❌ Isi link CSV spreadsheet dulu.';return}
 $('sheetStatus').textContent='⏳ Memuat bank soal dari Google Sheets...';
 try{const res=await fetch(url);if(!res.ok)throw new Error('HTTP '+res.status);const text=await res.text();const rows=parseCSV(text);if(rows.length<2)throw new Error('Data kosong');
  const head=rows[0].map(h=>(h||'').trim().toLowerCase()),idx=n=>head.indexOf(n);
  const iK=idx('kelas'),iS2=idx('semester'),iM=idx('materi'),iQ=idx('soal'),iA=idx('a'),iB=idx('b'),iC=idx('c'),iD=idx('d');
  if(iQ<0||iA<0||iB<0||iC<0||iD<0)throw new Error('Kolom Soal/A/B/C/D tidak ditemukan di header');
  SHEETROWS=rows.slice(1).map(r=>({kelas:iK>=0?(r[iK]||'').trim():'',semester:iS2>=0?(r[iS2]||'').trim():'',materi:iM>=0?(r[iM]||'').trim():'',q:[r[iQ],r[iA],r[iB],r[iC],r[iD]].map(x=>(x||'').trim())})).filter(d=>d.q[0]&&d.q[1]);
  if(!SHEETROWS.length)throw new Error('Tidak ada baris soal yang valid');
  $('sheetStatus').textContent=`✅ ${SHEETROWS.length} soal termuat dari spreadsheet`;
  const kelasList=[...new Set(SHEETROWS.map(d=>d.kelas).filter(Boolean))].sort((a,b)=>a.localeCompare(b,'id',{numeric:true}));
  $('fKelas').innerHTML='<option value="" disabled selected>-- Pilih Kelas --</option>'+kelasList.map(k=>`<option value="${k}">Kelas ${k}</option>`).join('');
  onKelasChange();$('filterWrap').style.display='flex'}
 catch(e){$('sheetStatus').textContent='❌ Gagal memuat bank soal ('+e.message+'). Perbaiki link lalu klik Muat Ulang.';SHEETROWS=[];$('filterWrap').style.display='none';$('startBtn').disabled=true}}
function onKelasChange(){const k=$('fKelas').value,pool=k?SHEETROWS.filter(d=>d.kelas==k):[];
 const semList=[...new Set(pool.map(d=>d.semester).filter(Boolean))].sort((a,b)=>a.localeCompare(b,'id',{numeric:true}));
 $('fSemester').innerHTML='<option value="" disabled selected>-- Pilih Semester --</option>'+semList.map(sm=>`<option value="${sm}">Semester ${sm}</option>`).join('');
 onSemesterChange()}
function onSemesterChange(){const k=$('fKelas').value,sm=$('fSemester').value,pool=(k&&sm)?SHEETROWS.filter(d=>d.kelas==k&&d.semester==sm):[];
 const materiList=[...new Set(pool.map(d=>d.materi).filter(Boolean))].sort((a,b)=>a.localeCompare(b,'id'));
 $('fMateri').innerHTML='<option value="" disabled selected>-- Pilih Materi --</option>'+materiList.map(m=>`<option value="${m}">${m}</option>`).join('');
 onMateriChange()}
function curPool(){const k=$('fKelas').value,sm=$('fSemester').value,m=$('fMateri').value;if(!k||!sm||!m)return null;return SHEETROWS.filter(d=>d.kelas==k&&d.semester==sm&&d.materi==m)}
function onMateriChange(){const k=$('fKelas').value,sm=$('fSemester').value,m=$('fMateri').value;
 if(!k||!sm||!m){$('bankCount').innerHTML='<span style="color:#f5b93a">👉 Pilih Kelas, Semester, dan Materi dulu untuk memulai.</span>';$('startBtn').disabled=true;return}
 const pool=curPool();
 if(!pool.length){$('bankCount').innerHTML='<span style="color:#ff6b6b">⚠️ Soal untuk Kelas '+k+' &middot; Semester '+sm+' &middot; '+m+' belum tersedia di spreadsheet.</span>';$('startBtn').disabled=true;return}
 if(pool.length<3){$('bankCount').innerHTML='<span style="color:#ff6b6b">⚠️ Baru '+pool.length+' soal untuk pilihan ini, minimal 3. Tambahkan soal di spreadsheet.</span>';$('startBtn').disabled=true;return}
 $('bankCount').innerHTML=`📚 ${pool.length} soal siap dipakai`;$('startBtn').disabled=false}
function startT(){const pool=curPool();if(!pool||pool.length<3){alert('Pilih Kelas dan Materi yang punya minimal 3 soal dulu.');return}
 const n=$('names').value.split('\n').map(s=>s.trim()).filter(Boolean),c=+$('cnt').value;WN=LN=c>=16?3:2;revealed=false;H=[];SR=0;phase='swiss';M=[];mi=0;BYE=null;BYT='';PO=[];SEQ=[];P=[];for(let i=0;i<c;i++)P.push({n:n[i]||'Peserta '+(i+1),w:0,l:0,st:'swiss',rc:VARIANTS[Math.floor(Math.random()*VARIANTS.length)]});
 CURBANK=pool.map(d=>d.q);QO=sh(CURBANK.map((_,i)=>i));qp=0;shuffleAnim()}
function pairUp(a){a=sh(a).sort((x,y)=>(y.w-y.l)-(x.w-x.l));let bye=null;if(a.length%2){for(let i=a.length-1;i>=0;i--)if(!a[i].bye){bye=a.splice(i,1)[0];break}if(!bye)bye=a.pop();bye.bye=(bye.bye||0)+1}const r=[];for(let i=0;i<a.length;i+=2)r.push([a[i],a[i+1]]);return{r,bye}}
function pairRandom(a){a=sh(a);let bye=null;if(a.length%2)bye=a.pop();const r=[];for(let i=0;i<a.length;i+=2)r.push([a[i],a[i+1]]);return{r,bye}}
function shuffleAnim(){show('shuffle');$('shBoard').innerHTML=sh(P).map(p=>`<span class="ch swiss shf">${p.n}</span>`).join('');let i=0;const iv=setInterval(()=>snd(300+(i++%6)*40,.08),160);setTimeout(()=>{clearInterval(iv);snd(700,.3,'triangle');round()},1600)}
function round(){let pool,b;BYT='';
 if(phase=='swiss'){pool=P.filter(p=>p.st=='swiss');if(!pool.length)return endSwiss();
  ({r:M,bye:b}=pairUp(pool));if(b){b.w++;if(b.w>=WN)b.st='q'}SR++;M.forEach(m=>{m.box=m[0].w+'-'+m[0].l;m.br='swiss';H.push(m)});$('ph').textContent='Swiss Stage';$('rule').textContent=`Menang ${WN}x lolos Playoff • Kalah ${LN}x masuk Wildcard`}
 else if(phase=='wc'){pool=P.filter(p=>p.st=='wc');const need=pool.length-SLOTS;
  if(need<=0){pool.forEach(p=>p.st='po');return startPO(SEEDS.concat(sh(pool)))}
  const d=Math.min(Math.floor(pool.length/2),need);pool=sh(pool);M=[];for(let i=0;i<d;i++)M.push([pool[2*i],pool[2*i+1]]);
  M.forEach(m=>{m.br='wc';H.push(m)});BYT=pool.slice(2*d).map(p=>p.n).join(', ');$('ph').textContent='⚡ Wildcard';$('rule').textContent=`Sistem gugur — ${SLOTS} pemenang terakhir masuk Playoff`}
 else{const g=SEQ.find(gr=>gr.some(t=>!t.done));if(!g)return;
  M=g.map(t=>{const m=[res(t.a),res(t.b)];m.t=t;m.br=t.br;return m});const t0=g[0];
  $('ph').textContent=t0.br=='ub'?'🔵 Upper Bracket • Ronde '+t0.r:t0.br=='lb'?'🟣 Lower Bracket • Ronde '+t0.r:'🏆 GRAND FINAL';
  $('rule').textContent=t0.br=='ub'?'Kalah = turun ke Lower Bracket (belum gugur)':t0.br=='lb'?'Kalah = langsung tersingkir':'Juara Upper Bracket vs Juara Lower Bracket'}
 BYE=b;mi=0;draw()}
function endSwiss(){const Q=P.filter(p=>p.st=='q').sort((a,b)=>(b.w-b.l)-(a.w-a.l)||Math.random()-.5),W=P.filter(p=>p.st=='wc');
 let K=4;while(K<Q.length)K*=2;K=Math.min(K,16);let cap=4;while(cap*2<=P.length)cap*=2;K=Math.min(K,cap);
 const direct=Q.slice(0,K);Q.slice(K).forEach(p=>p.st='out');direct.forEach(p=>p.st='po');SLOTS=K-direct.length;SEEDS=direct;
 if(SLOTS<=0){W.forEach(p=>p.st='out');return startPO(direct)}
 if(W.length<=SLOTS){W.forEach(p=>p.st='po');return startPO(direct.concat(W))}
